<?xml version="1.0" encoding="utf-8"?>
<!-- OWASP MASVS-STORAGE-2 / CWE-921: Android 12+ (API 31+) Data Extraction Rules.
     Prevents extraction and unauthorized backup of local application storage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>

