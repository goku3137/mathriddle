<?xml version="1.0" encoding="utf-8"?>
<!-- OWASP MASVS-STORAGE-2 / CWE-921: Android Backup Rules (Pre-API 31).
     Prevents ADB backup extraction of local shared preferences and internal files. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
</full-backup-content>

